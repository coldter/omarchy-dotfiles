{{- /* Runs once per machine during `chezmoi init`. Prompts for per-machine
data used by templates (dot_config/hypr/monitors.lua.tmpl,
run_once_after_20-theme.sh.tmpl).

`machine` is a machine PROFILE LABEL — deliberately NOT the hostname.
It is a stable, human-chosen key that selects the matching block in
per-machine templates. Hostnames can change (reinstalls, DHCP, cloning);
this label is set once per machine and travels in ~/.config/chezmoi/chezmoi.toml.
Two machines may share a label only if their hardware config is identical.

Defaults keep the prompts one-Enter quick. */ -}}

{{- $machine := promptStringOnce . "machine" "Machine profile label (e.g. desktop, laptop, studio)" "desktop" -}}
{{- $themeName := promptStringOnce . "themeName" "Omarchy theme to apply on setup" "matte-black" -}}

[data]
    machine = {{ $machine | quote }}
    themeName = {{ $themeName | quote }}
