#!/bin/bash
# run_once_after_20-theme.sh  (rendered from .tmpl)
#
# Omarchy keeps generated theme state in ~/.local/state/omarchy/ (terminal
# colors, background) — that state is NOT tracked in dotfiles; it is
# regenerated by this command. Tolerates running outside a session: file
# generation succeeds, session-bound parts fail soft.
#
# themeName is templated INTO the body on purpose: changing [data] themeName
# via `chezmoi edit-config` changes this script's content hash, so the next
# `chezmoi apply` re-runs it — that is how a theme choice survives a reinstall.
set -u

# index|default (not .themeName) so a hand-edited config without the key can
# never hard-fail `chezmoi apply`.
THEME={{ (index . "themeName" | default "matte-black") | quote }}

if command -v omarchy >/dev/null 2>&1; then
  echo ">> Applying Omarchy theme: $THEME"
  omarchy theme set "$THEME" || echo "!! theme set failed (no session?) — run later: omarchy theme set $THEME"
else
  echo "!! omarchy CLI not found — run later: omarchy theme set $THEME"
fi
