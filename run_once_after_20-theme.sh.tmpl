#!/bin/bash
# run_once_after_20-theme.sh  (rendered from .tmpl — theme name comes from
# chezmoi.toml [data] themeName, asked during `chezmoi init`)
#
# Omarchy stores generated theme state in ~/.local/state/omarchy/ (terminal
# colors, background) — that state is NOT tracked in dotfiles; it is
# regenerated by this command. Tolerates running outside a full session.
set -u

THEME="{{ .themeName }}"

if command -v omarchy >/dev/null 2>&1; then
  echo ">> Applying Omarchy theme: $THEME"
  omarchy theme set "$THEME" || echo "!! theme set failed (no session?) — run later: omarchy theme set $THEME"
else
  echo "!! omarchy CLI not found — run later: omarchy theme set $THEME"
fi
