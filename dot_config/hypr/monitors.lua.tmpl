-- See https://wiki.hypr.land/Configuring/Basics/Monitors/
-- List current monitors and supported resolutions with: hyprctl monitors all
--
-- ═══════════════════════════════════════════════════════════════════════════
-- MACHINE-SPECIFIC FILE — this is a CHEZMOI TEMPLATE, not a plain config.
--
-- HOW IT WORKS
--   Blocks are keyed on the `machine` profile variable — NOT the hostname.
--   It is set once per machine in ~/.config/chezmoi/chezmoi.toml:
--       [data]
--           machine = "desktop"
--   Only the block matching this machine's profile is rendered into
--   ~/.config/hypr/monitors.lua; all other blocks are stripped. A machine
--   whose profile has no dedicated block (or an unset key) falls through to
--   the generic fallback at the bottom, so a fresh machine always boots with
--   a working display config.
--
-- ADDING A NEW MACHINE (human or agent) — full guide: README.md §5
--   1. On the new machine:  hyprctl monitors all      (note outputs/modes)
--   2. Set the profile:     ~/.config/chezmoi/chezmoi.toml →
--                           [data] machine = "<label>"
--   3. Edit the template:   chezmoi edit ~/.config/hypr/monitors.lua
--   4. Add a block for <label>, same style as the "desktop" block, INSERTED
--      ABOVE the generic {{"{{"}} else {{"}}"}} fallback at the bottom — an
--      "else if" placed after "else" is a template parse error and
--      chezmoi apply will refuse to render:
--        {{"{{"}} else if eq .machine "<label>" {{"}}"}}
--        hl.monitor({ output = "...", mode = "preferred", position = "0x0", scale = 1 })
--      (the escaped-brace forms above render as literal double braces)
--   5. Render + reload:     chezmoi apply ~/.config/hypr/monitors.lua
--   6. Validate:            hyprctl configerrors        (must print nothing)
--   7. Sync:                chezmoi git -- add -A
--                           && chezmoi git -- commit -m "monitors: <label>"
--      (do NOT use `chezmoi re-add` for THIS file — see next section)
--
-- WHEN OMARCHY REWRITES THE RENDERED FILE (update/refresh)
--   chezmoi diff      → see what Omarchy changed
--   ⚠ `chezmoi re-add` will NOT adopt changes for this file — chezmoi refuses
--     to overwrite templates. Reconcile by hand:
--       chezmoi edit ~/.config/hypr/monitors.lua   (opens THIS template)
--       chezmoi apply ~/.config/hypr/monitors.lua
--   (the post-update hook will have notified you about the drift)
-- ═══════════════════════════════════════════════════════════════════════════

{{ if eq (index . "machine" | default "") "desktop" }}
-- desktop: TV on top (HDMI), main monitor below (Samsung 144Hz via DP)
-- Both displays are 1080p, so use 1x scaling.
hl.env("GDK_SCALE", "1")

hl.monitor({ output = "HDMI-A-1", mode = "1920x1080@60", position = "0x0", scale = 1 })
hl.monitor({ output = "DP-2", mode = "preferred", position = "0x1080", scale = 1 })

-- Lock workspace 1 to the top monitor only; it never gets another workspace.
-- All other workspaces (2-10) live on the bottom monitor and cycle freely there.
hl.workspace_rule({ workspace = "1", monitor = "HDMI-A-1", persistent = true })
for workspace = 2, 10 do
  hl.workspace_rule({ workspace = tostring(workspace), monitor = "DP-2" })
end
{{ else }}
-- ▼▼ GENERIC FALLBACK — rendered when no block matches this machine's profile ▼▼
-- Replace with this machine's real outputs (hyprctl monitors all), then set
-- [data] machine in ~/.config/chezmoi/chezmoi.toml and add a dedicated block
-- above (see README.md §5).
hl.env("GDK_SCALE", "1")
hl.monitor({ output = "eDP-1", mode = "preferred", position = "0x0", scale = 1 })
{{ end }}
